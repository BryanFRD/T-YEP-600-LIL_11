// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id              String        @id @default(cuid())
  email           String        @unique 
  name            String
  firstname       String
  password        String 
  username        String        @unique
  lastConnection  DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  games           PlayerGame[] 
  stats           PlayerStats?

  @@map("players")
}

model Game {
  id          String      @id @default(cuid())
  finishedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?
  players     PlayerGame[]

  @@map("games")
}

model PlayerGame {
  id         String   @id @default(cuid())
  playerId   String 
  gameId     String
  team       String   
  countDeath Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  player Player @relation(fields: [playerId], references: [id])
  game   Game   @relation(fields: [gameId], references: [id])

  @@map("players_games")
}

model PlayerStats {
  id          String   @id @default(cuid())
  playerId    String   @unique
  countKill   Int      @default(0)
  countDeath  Int      @default(0)
  countAssist Int      @default(0)
  countWin    Int      @default(0)
  countLose   Int      @default(0)
  countDraw   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  player Player @relation(fields: [playerId], references: [id])

  @@map("players_stats")
}