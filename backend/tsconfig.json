{
  "compilerOptions": {
    "target": "es6", // Spécifie la version ECMAScript cible pour le code JavaScript généré
    "module": "commonjs", // Spécifie le module code generation: 'none', 'commonjs', 'amd', 'system', 'umd', 'es6', 'es2015' ou 'ESNext'
    "strict": true, // Active toutes les options strictes de type
    "esModuleInterop": true, // Active l'interopérabilité des modules ES6 par défaut pour importer des modules CommonJS
    "skipLibCheck": true, // Ignore les vérifications de type dans les fichiers de déclaration
    "forceConsistentCasingInFileNames": true, // Assure que la casse des noms de fichiers est cohérente
    "outDir": "./dist", // Redirige la sortie des fichiers .js1
    "resolveJsonModule": true
  },
  "include": [
    "src/docs/swagger-output.json",
    "src/**/*", "src"
  ], // Spécifie un tableau de noms de fichiers à inclure dans le programme
  "exclude": ["node_modules", "**/*.spec.ts"] // Exclut les fichiers ou dossiers spécifiés
}
