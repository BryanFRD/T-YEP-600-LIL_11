    "sequelize:migrate": "ts-node node_modules/sequelize-cli/lib/sequelize db:migrate",
    "sequelize:remove": "ts-node node_modules/sequelize-cli/lib/sequelize db:migrate:undo:all",
    "sequelize:generate": "ts-node node_modules/sequelize-cli/lib/sequelize migration:generate"
  },
